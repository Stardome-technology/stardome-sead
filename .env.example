# ── Stardome SEAD Service ── Environment Configuration ─────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env, *.key, *.pem, or secrets/ to version control.
#
# Every comment here sits on its own line: Compose reads a comment that follows
# an empty value, such as `EDGE_ID=   # Edge ID`, as the value itself.
#
# Required variables are marked "Required" below and hold example values that
# only let `docker compose config` resolve: replace each one with your own.
# With a required variable unset or empty, `docker compose` stops and names it.

# ── Compose files ────────────────────────────────────────────────────────────
# The files a plain `docker compose` command uses in this directory: the base
# file plus the production overlay. For development, use
# compose.yaml:compose.development.yaml instead.
COMPOSE_FILE=compose.yaml:compose.production.yaml

# ── General ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
SERVICE_NAME=sead-core

# ── Public Port Contract ──────────────────────────────────────────────────
# Cross-organization ports that MUST be identical across all federation
# participants. See docs/public-port-contract.md for rationale.
# Published host port for cross-org event fetch
SEAD_CORE_PUBLIC_PORT=30080

# ── sead-core ────────────────────────────────────────────────────────────────
SEAD_CORE_PORT=50051
SEAD_CORE_DB_PATH=/data/sead.db

# ── edge-service ─────────────────────────────────────────────────────────────
EDGE_SERVICE_PORT=50055
# Required. Organization ID (hex)
EDGE_ORG_ID=1111111111111111111111111111111111111111111111111111111111111111
# Required. Edge ID (hex)
EDGE_ID=2222222222222222222222222222222222222222222222222222222222222222
# edge-service's keys are host files, mounted as Compose secrets, never values
# in this file. Each file holds the key as bare hex on one line, with no
# `KEY=` prefix, at mode 0400. On native Docker Engine on Linux, each file is
# owned by edge-service's user, 100:101 (`sudo chown 100:101 <file>`); on
# Docker Desktop, by you. Paths are absolute or relative to this directory.
# Keep them outside ./secrets/, which the gateway mounts. See the README,
# "Key files".
# Required. File holding the edge XMSS secret key (hex)
EDGE_SIGNING_KEY_FILE=./keys/edge_signing_key.hex
# Required. File holding the org XMSS secret key, which signs auth tokens (hex)
EDGE_ORG_SIGNING_KEY_FILE=./keys/org_signing_key.hex
# Required. File holding the org XMSS public key (hex)
EDGE_ORG_PUBLIC_KEY_FILE=./keys/org_public_key.hex
# Auth token TTL in seconds
EDGE_TOKEN_TTL=300
# Go pin service gRPC target (IPFS pin leg)
EDGE_PIN_SERVICE_URL=pin-service:50056
# DAG commit (watchdog) cadence in seconds (fractional allowed, e.g. 0.25)
EDGE_WATCHDOG_INTERVAL_SEC=1
# IPFS pin loop cadence (independent, slow)
EDGE_PIN_INTERVAL_SEC=30
# -1 = unlimited; otherwise cap
EDGE_PIN_MAX_RETRIES=-1
# pin retry exponential backoff base
EDGE_PIN_BACKOFF_BASE_SEC=30
# pin retry max delay (1 day)
EDGE_PIN_BACKOFF_CAP_SEC=86400
# single | batch
EDGE_COMMIT_STRATEGY=single
EDGE_BATCH_FLUSH_INTERVAL_SEC=300

# Required. Shared secret the gateway requires as `Authorization: Bearer <value>` on its public HTTPS endpoints
SEAD_AUTH_SECRET=change-me

GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Comma-separated peer gateway base URLs for cross-node sync fetch
GATEWAY_PEERS=
# Per-node edge token this gateway presents to a peer gateway (`Authorization: Bearer`) when fetching a missing event.
GATEWAY_PEER_TOKEN=
# Comma-separated edge token secrets
GATEWAY_EDGE_TOKENS=
# POC uses self-signed certs — skip TLS verification for peer gateway fetch.
# (Production/cross-org: set false and use GATEWAY_PEER_CA_CERT or public certs.)
GATEWAY_PEER_TLS_INSECURE=true

# ── gossip-node (C2 sync observer) ───────────────────────────────────────────
# Native libp2p Gossipsub frontier dissemination + DHT/mDNS discovery + gRPC
# fetch/validate. Replaces the legacy sead-sync + p2pd HTTP/SSE facade.
# Required. Organization ID (hex, 64 chars) — same as EDGE_ORG_ID
GOSSIP_ORG_ID=1111111111111111111111111111111111111111111111111111111111111111
# Comma-separated org_ids this node observes (own org always observed)
GOSSIP_OBSERVE_ORGS=
GOSSIP_LISTEN=/ip4/0.0.0.0/tcp/31002
# Comma-separated libp2p multiaddrs of other nodes (/ip4/<ip>/tcp/31002/p2p/<peerid>)
GOSSIP_BOOTSTRAP=
# Required. This node's reachable multiaddr, e.g. /ip4/<public_ip>/tcp/31002.
# Without it the node advertises its container IP (e.g. 172.18.x.x) to peers
# and every inbound dial fails with "no good addresses" / "dial to self", even
# with correct bootstrap PeerIds.
GOSSIP_ADVERTISE=/ip4/203.0.113.10/tcp/31002
GOSSIP_MDNS=true
GOSSIP_DHT=true
GOSSIP_HEARTBEAT_SEC=10
GOSSIP_CORE=sead-core:50051
GOSSIP_GATEWAY=gateway:50054
GOSSIP_PNET=false
# Persistent libp2p identity key — keeps the PeerId stable across restarts so
# published bootstrap/catalog multiaddrs stay valid. Must live INSIDE the
# mounted gossip_data volume dir (/data/gossip-keys): a path outside it is not
# persisted, the PeerId is regenerated on every container recreate, and every
# published bootstrap multiaddr goes stale ("peer id mismatch"). Capture the
# PeerId once from the startup log: docker logs <gossip container> | grep "peer ID"
GOSSIP_IDENTITY_KEY_FILE=/data/gossip-keys/gossip-identity.key

# ── pin-service (Go) ─────────────────────────────────────────────────────────
PIN_SERVICE_PORT=50056
IPFS_API_BASE_URL=https://ipfs.stardome.cloud

# ── storage-gateway ──────────────────────────────────────────────────────────
STORAGE_GATEWAY_PORT=50052
IPFS_API_BASE_URL=https://ipfs.stardome.cloud
STORAGE_PUBLISH_RECEIPTS=true

# ── source-data-service ──────────────────────────────────────────────────────
SOURCE_DATA_SERVICE_PORT=50053
SOURCE_DATA_DB_PATH=/data/source_data.db
# Comma-separated org_ids
SOURCE_DATA_TRUSTED_VERIFIERS=

# ── Development overlay (compose.development.yaml only) ──────────────────────
# Required by compose.development.yaml only. Local checkouts to build the
# images from, as absolute paths or relative to this directory.
SEAD_SOURCE_DIR=../sead-source
SEAD_GATEWAY_SOURCE_DIR=../sead-gateway-source

# ── Build-only variables ────────────────────────────────────────────────────
# Build/publish vars have been moved to config/.env.build (gitignored).
# See config/.env.build for: PUBLISH_GHCR, GHCR_USERNAME, GHCR_TOKEN
