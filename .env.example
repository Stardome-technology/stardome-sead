# ── Stardome SEAD Service ── Environment Configuration ─────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env, *.key, *.pem, or secrets/ to version control.

# ── General ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info                     # debug | info | warn | error
SERVICE_NAME=sead-core

# ── Public Port Contract ──────────────────────────────────────────────────
# Cross-organization ports that MUST be identical across all federation
# participants. See docs/public-port-contract.md for rationale.
SEAD_CORE_PUBLIC_PORT=30080         # Published host port for cross-org event fetch

# ── sead-core ────────────────────────────────────────────────────────────────
SEAD_CORE_PORT=50051
SEAD_CORE_DB_PATH=/data/sead.db

# ── edge-service ─────────────────────────────────────────────────────────────
EDGE_SERVICE_PORT=50055
EDGE_ORG_ID=                        # Organization ID (hex)
EDGE_ID=                            # Edge ID (hex)
EDGE_SIGNING_KEY=                   # Edge XMSS private key (hex)
# EDGE_SIGNING_KEY_FILE=/run/secrets/edge_key
EDGE_ORG_SIGNING_KEY=               # Org XMSS private key for auth tokens (hex)
# EDGE_ORG_SIGNING_KEY_FILE=/run/secrets/org_key
EDGE_ORG_PUBLIC_KEY=                # Org XMSS public key (hex)
# EDGE_ORG_PUBLIC_KEY_FILE=/run/secrets/org_pubkey
EDGE_TOKEN_TTL=300                  # Auth token TTL in seconds
EDGE_PIN_SERVICE_URL=pin-service:50056  # Go pin service gRPC target (IPFS pin leg)
EDGE_WATCHDOG_INTERVAL_SEC=1        # DAG commit (watchdog) cadence in seconds (fractional allowed, e.g. 0.25)
EDGE_PIN_INTERVAL_SEC=30             # IPFS pin loop cadence (independent, slow)
EDGE_PIN_MAX_RETRIES=-1              # -1 = unlimited; otherwise cap
EDGE_PIN_BACKOFF_BASE_SEC=30         # pin retry exponential backoff base
EDGE_PIN_BACKOFF_CAP_SEC=86400       # pin retry max delay (1 day)
EDGE_COMMIT_STRATEGY=single         # single | batch
EDGE_BATCH_FLUSH_INTERVAL_SEC=300

SEAD_AUTH_SECRET=                   # Shared secret the gateway requires as `Authorization: Bearer <value>` on its public HTTPS endpoints

GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
GATEWAY_PEERS=                      # Comma-separated peer gateway base URLs for cross-node sync fetch
GATEWAY_PEER_TOKEN=                 # Per-node edge token this gateway presents to a peer gateway (`Authorization: Bearer`) when fetching a missing event. 
GATEWAY_EDGE_TOKENS=                # Comma-separated edge token secrets |
# POC uses self-signed certs — skip TLS verification for peer gateway fetch.
# (Production/cross-org: set false and use GATEWAY_PEER_CA_CERT or public certs.)
GATEWAY_PEER_TLS_INSECURE=true

# ── gossip-node (C2 sync observer) ───────────────────────────────────────────
# Native libp2p Gossipsub frontier dissemination + DHT/mDNS discovery + gRPC
# fetch/validate. Replaces the legacy sead-sync + p2pd HTTP/SSE facade.
GOSSIP_ORG_ID=                      # Organization ID (hex, 64 chars) — same as EDGE_ORG_ID
GOSSIP_OBSERVE_ORGS=                # Comma-separated org_ids this node observes (own org always observed)
GOSSIP_LISTEN=/ip4/0.0.0.0/tcp/31002
GOSSIP_BOOTSTRAP=                   # Comma-separated libp2p multiaddrs of other nodes (/ip4/<ip>/tcp/31002/p2p/<peerid>)
GOSSIP_MDNS=true
GOSSIP_DHT=true
GOSSIP_HEARTBEAT_SEC=10
GOSSIP_CORE=sead-core:50051
GOSSIP_GATEWAY=gateway:50054
GOSSIP_PNET=false
# Persistent libp2p identity key — keeps the PeerId stable across restarts so
# published bootstrap/catalog multiaddrs stay valid. Stored on the gossip_data
# volume. Capture the PeerId once from the startup log.
GOSSIP_IDENTITY_KEY_FILE=/data/gossip-identity.key

# ── pin-service (Go) ─────────────────────────────────────────────────────────
PIN_SERVICE_PORT=50056
IPFS_API_BASE_URL=https://ipfs.stardome.cloud

# ── storage-gateway ──────────────────────────────────────────────────────────
STORAGE_GATEWAY_PORT=50052
IPFS_API_BASE_URL=https://ipfs.stardome.cloud
STORAGE_PUBLISH_RECEIPTS=true

# ── source-data-service ──────────────────────────────────────────────────────
SOURCE_DATA_SERVICE_PORT=50053
SOURCE_DATA_DB_PATH=/data/source_data.db
SOURCE_DATA_TRUSTED_VERIFIERS=      # Comma-separated org_ids

# ── Build-only variables ────────────────────────────────────────────────────
# Build/publish vars have been moved to config/.env.build (gitignored).
# See config/.env.build for: PUBLISH_GHCR, GHCR_USERNAME, GHCR_TOKEN

# ── Secret injection (Docker/K8s pattern) ────────────────────────────────────
# For each secret VAR, a corresponding VAR_FILE can be set.
# If VAR_FILE is set, the secret is read from that file path.
# Examples:
# ORG_SIGNING_KEY_FILE=/run/secrets/org_key
# EDGE_SIGNING_KEY_FILE=/run/secrets/edge_key